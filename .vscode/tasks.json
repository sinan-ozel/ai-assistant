{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Container",
            "type": "docker-build",
            "dockerBuild": {
                "context": "${workspaceFolder}",
                "dockerfile": "${workspaceFolder}/agent_stem/Dockerfile",
                "tag": "agent-stem:latest"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Container",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/agent_stem/docker-compose.yaml",
                "up"
            ],
            "dependsOn": ["Build Container"],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (No LLM)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_no_llm/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_no_llm",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (No Services)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_nothing/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_nothing",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (Mistral)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_mistral/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_mistral",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (Self-Hosted LLM)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_self_hosted_llm",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run All Tests",
            "dependsOn": [
                "Run Tests (No LLM)",
                "Run Tests (No Services)",
                "Run Tests (Mistral)",
                "Run Tests (Self-Hosted LLM)"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Reformat Code",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/reformat/docker-compose.yaml",
                "up",
                "--build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Export OpenAPI to YAML",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p ${workspaceFolder}/docs && curl -s http://localhost:8000/openapi.json | python3 -c \"import sys, json, yaml; print(yaml.dump(json.load(sys.stdin), default_flow_style=False, sort_keys=False))\" > ${workspaceFolder}/docs/openapi.yaml && echo 'OpenAPI spec written to docs/openapi.yaml'"
            ],
            "problemMatcher": []
        }
    ]
}
