{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Container",
            "type": "docker-build",
            "dockerBuild": {
                "context": "${workspaceFolder}",
                "dockerfile": "${workspaceFolder}/agent_stem/Dockerfile",
                "tag": "agent-stem:latest"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Agent",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/agent_stem/docker-compose.yaml",
                "up"
            ],
            "dependsOn": ["Build Container"],
            "problemMatcher": [],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/${input:agent}/cortex",
                    "DEV_DATA_FOLDER": "${workspaceFolder}/test_agents/${input:agent}/dev-data"
                }
            },
        },
        {
            "label": "Run Tests (No LLM)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_no_llm/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_no_llm",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (No Services)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_nothing/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_nothing",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (Mistral)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_mistral/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_mistral",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (Self-Hosted LLM)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_self_hosted_llm",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Tests (Local LLM)",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_local_llm/docker-compose.yaml",
                "--project-directory", "${workspaceFolder}/test_environments/test_env_local_llm",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_environments/test_env_local_llm/cortex"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_${input:test_env}/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/${input:agent}/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/${input:agent}/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Reformat Code",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/reformat/docker-compose.yaml",
                "up",
                "--build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/lint/docker-compose.yaml",
                "up",
                "--build",
                "--abort-on-container-exit",
                "--exit-code-from",
                "linter"
            ],
            "dependsOn": ["Reformat Code"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Run Integration Tests: image_workflows @ self_hosted_llm",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/image_workflows/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/image_workflows/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Integration Tests: text_workflows @ self_hosted_llm",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/text_workflows/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/text_workflows/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Integration Tests: son_of_anton @ self_hosted_llm",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/son_of_anton/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/son_of_anton/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Integration Tests: talk_to_your_documents @ self_hosted_llm",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_self_hosted_llm/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/talk_to_your_documents/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/talk_to_your_documents/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run Integration Tests: talk_to_your_documents @ no_qdrant",
            "type": "shell",
            "command": "docker",
            "args": [
                "compose",
                "-f", "${workspaceFolder}/test_environments/test_env_no_qdrant/docker-compose.yaml",
                "up",
                "--build",
                "--exit-code-from", "tests"
            ],
            "options": {
                "env": {
                    "AGENT_FOLDER": "${workspaceFolder}/test_agents/talk_to_your_documents/cortex",
                    "TEST_FOLDER": "${workspaceFolder}/test_agents/talk_to_your_documents/tests"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run All Agent Integration Tests",
            "dependsOn": [
                "Run Integration Tests: text_workflows @ self_hosted_llm",
                "Run Integration Tests: image_workflows @ self_hosted_llm",
                "Run Integration Tests: son_of_anton @ self_hosted_llm",
                "Run Integration Tests: talk_to_your_documents @ self_hosted_llm",
                // "Run Integration Tests: talk_to_your_documents @ no_qdrant",
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "(!) Run All Tests",
            "dependsOn": [
                "Lint",
                // "Run Tests (Local LLM)",
                "Run Tests (Self-Hosted LLM)",
                "Run All Agent Integration Tests"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Curl Ollama Models (Tailscale)",
            "type": "shell",
            "command": "curl",
            "args": [
                "http://localhost:11434/api/tags"
            ],
            "problemMatcher": []
        },
        {
            "label": "Curl llama.cpp Models (Tailscale)",
            "type": "shell",
            "command": "curl",
            "args": [
                "http://localhost:8080/v1/models"
            ],
            "problemMatcher": []
        },
        {
            "label": "Export OpenAPI to YAML",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p ${workspaceFolder}/docs && curl -s http://localhost:8000/openapi.json | python3 -c \"import sys, json, yaml; print(yaml.dump(json.load(sys.stdin), default_flow_style=False, sort_keys=False))\" > ${workspaceFolder}/docs/openapi.yaml && echo 'OpenAPI spec written to docs/openapi.yaml'"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "agent",
            "type": "pickString",
            "description": "Choose the agent",
            "options": [
                "text_workflows",
                "image_workflows",
                "son_of_anton",
                "talk_to_your_documents"
            ],
            "default": "text_workflows"
        },
        {
            "id": "test_env",
            "type": "pickString",
            "description": "Choose the test environment",
            "options": [
                "default",
                "mistral",
                "no_qdrant",
                "no_llm",
                "nothing"
            ],
            "default": "default"
        }
    ]
}
