{
    "name": "micro-service-agent-devcontainer",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "remoteUser": "root",
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind"
    ],
    "features": {
	    "ghcr.io/devcontainers/features/docker-in-docker:2": {
	      "version": "latest",
	      "moby": false,
	      "dockerDashComposeVersion": "v2",
	      "enableNonRootDocker": "false"
	    },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
		        "github.copilot",
		        "github.copilot-chat",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "clemenspeters.format-json",
                "euskadi31.json-pretty-printer",
                "jgalianoz.qr-generator",
                "github.vscode-github-actions",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "redhat.vscode-yaml",
                "Tim-Koehler.helm-intellisense",
                "ms-vscode.makefile-tools"
            ]
        }
    },
    "postStartCommand": "nohup dockerd > /var/log/dockerd.log 2>&1 & sleep 5 && echo 'Docker daemon started' && timeout 30 bash -c 'until nc -z redis 6379 2>/dev/null; do echo Waiting for Redis...; sleep 2; done' && echo 'Redis is ready' && echo 'DevContainer ready!'",
}
